# Get all books
GET http://localhost:3001/books HTTP/1.1
Content-Type: application/json

###

# Create new book
POST http://localhost:3001/books HTTP/1.1
Content-Type: application/json

{
    "tittle": "Harry Potter"
}

###

# Update a book
PUT http://localhost:3001/books/2 HTTP/1.1
Content-Type: application/json

{
    "tittle": "Dark Knight"
}


###

# Delete book
DELETE http://localhost:3001/books/2 HTTP/1.1
Content-Type: application/json
